# Copy to .env; never overwrite your existing secrets.
# Compose local single-user deployment. Required: choose new database passwords.
# Use URL-safe alphanumeric passwords here (MYSQL_PASSWORD is part of DATABASE_URL).
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_PASSWORD=change_this_app_password
MYSQL_USER=lifeflow
MYSQL_DATABASE=lifeflow_researchgraph
# Internal service DNS/ports, not host-published ports.
MYSQL_HOST=mysql
MYSQL_PORT=3306
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
# Host ports can be changed to avoid existing development services.
FRONTEND_PORT=5173
BACKEND_PORT=8000
MYSQL_PUBLISHED_PORT=3307
CHROMA_PUBLISHED_PORT=8001
# Build-time API origin: / uses nginx same-origin /api and /health proxy.
VITE_API_BASE_URL=/
APP_ENV=production
# Optional until using Ask/Research. Empty key does not prevent Library/Search.
# Provider uses the existing OpenAI-compatible client; there is no LLM_PROVIDER setting.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./data/model_cache
EMBEDDING_DIMENSION=512
EMBEDDING_VERSION=embedding-v1

GRAPH_EXTRACTOR_MODE=llm
GRAPH_EXTRACTOR_VERSION=graph-extractor-v1

PARSER_VERSION=parser-v1
CHUNK_SIZE=700
CHUNK_OVERLAP=100
DENSE_TOP_K=8
BM25_TOP_K=8
GRAPH_MAX_HOPS=2
GRAPH_MAX_NEIGHBORS=12
GRAPH_MAX_PATHS=20
RRF_K=60
GRAPH_MIN_RELATION_CONFIDENCE=0.45

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# Local content-addressed raw snapshots (never committed).
SOURCE_STORAGE_ROOT=./storage
CHUNKER_VERSION=text-chunker-v1

# Conditional Graph (bounded retrieval; no LLM router)
GRAPH_MAX_EXPANDED_ENTITIES=32
GRAPH_HOP_DECAY=0.7
GRAPH_RRF_WEIGHT=0.5

# Optional post-fusion ranking experiment (disabled until real validation).
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_REVISION=465b4b7ddf2be0a020c8ad6e525b9bb1dbb708ae
RERANKER_DEVICE=cpu
RERANKER_CANDIDATE_N=20
RERANKER_FINAL_K=10

# Bounded single research comparison workflow
RESEARCH_MAX_SUBTASKS=8
RESEARCH_TOP_K=5
RESEARCH_MAX_RETRIES=1
RESEARCH_MAX_DOCUMENTS=5
RESEARCH_MAX_EVIDENCE=40

# Phase 9 execution attempts (including retries), separate from workflow refinement.
RESEARCH_MAX_MODEL_CALLS=36
RESEARCH_MAX_TOOL_CALLS=40
RESEARCH_MAX_RETRIEVAL_CALLS=34
RESEARCH_MAX_RUNTIME_SECONDS=300
RESEARCH_TOOL_TIMEOUT_SECONDS=60

# Optional derived enrichment; base Search/QA/Research do not require Graph.
GRAPH_EXTRACTION_ENABLED=false
