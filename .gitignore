reports/*.json
reports/*.jsonl
reports/*.md
backend/reports/
backend/tests/fixtures/hard_eval/resolved_cases.jsonl

# Local research PDFs; manifests and annotations remain versionable.
/benchmarks/real_research/papers/*.[pP][dD][fF]
/benchmarks/real_reasearch/papers/*.[pP][dD][fF]

# Local execution captures may contain paper snippets and machine paths.
/artifacts/
**/traces/
*.trace.json
*.har

# Local credentials, tool settings, model weights and internal acceptance notes.
runtime.env
*.key
*.pem
.claude/
*.safetensors
*.onnx
*.pt
*.pth
/docs/PHASE*_VALIDATION.md
/docs/phase0_repository_state.json
/docs/RELEASE_GATE.md
# Existing tracked notes must also be removed from the index before publication.

# PDFs are local inputs, including old manually-created upload fixtures.
*.[pP][dD][fF]
# Keep frozen dataset definitions used by regression; exclude local execution records.
/benchmarks/agent/results/
/benchmarks/agent/phase10_1/
/benchmarks/agent/badcases/
/benchmarks/agent/*REVIEW.md
/benchmarks/real_research/results/
/benchmarks/real_research/annotation_catalog.jsonl
/benchmarks/real_research/PILOT_ANNOTATION_REVIEW.md
/benchmarks/real_research/corpus_discovery.json
/benchmarks/real_research/onboarding_report.json
/benchmarks/real_research/pilot_finalization*.json
/benchmarks/real_research/pilot_queries_candidates.json

